{
  "name": "onlais",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:worker": "npm --workspace apps/worker run dev",
    "lint": "npm --workspace apps/web run lint",
    "typecheck": "npm --workspace apps/web run typecheck",
    "test:aisha-dialogs": "node scripts/aisha-dialog-regression.mjs --suite=all",
    "test:aisha-dialogs:static": "node scripts/aisha-dialog-regression.mjs --suite=static",
    "test:aisha-dialogs:core": "node scripts/aisha-dialog-regression.mjs --suite=core",
    "test:aisha-dialogs:booking": "node scripts/aisha-dialog-regression.mjs --suite=booking-e2e",
    "test:aisha-dialogs:client": "node scripts/aisha-dialog-regression.mjs --suite=client-actions",
    "test:aisha-dialogs:smoke": "node scripts/aisha-smoke-scenarios.mjs",
    "test:crm-agent-v2:dialogs": "node scripts/crm-agent-v2-dialog-tests.mjs",
    "test:crm-agent-v2:ui": "node scripts/crm-agent-v2-ui-tests.mjs",
    "test:crm-agent-v2:integration": "node scripts/crm-agent-v2-integration-tests.mjs",
    "test:crm-agent-v2:integration:local": "powershell -ExecutionPolicy Bypass -File ./scripts/run-crm-agent-v2-integration-local.ps1",
    "test:crm-agent-v2:real-e2e:local": "powershell -ExecutionPolicy Bypass -File ./scripts/run-crm-agent-v2-real-e2e-local.ps1",
    "test:crm-agent-v2:canonicalizer": "node scripts/crm-agent-v2-plan-canonicalizer-tests.mjs",
    "test:crm-agent-v2:catalog": "node scripts/crm-agent-v2-action-catalog-tests.mjs",
    "test:crm-agent-v2:inspector": "node scripts/crm-agent-v2-inspector-tests.mjs",
    "test:crm-agent-v2:hardening": "node scripts/crm-agent-v2-hardening-tests.mjs",
    "test:crm-agent-v2": "npm run test:crm-agent-v2:catalog && npm run test:crm-agent-v2:canonicalizer && npm run test:crm-agent-v2:inspector && npm run test:crm-agent-v2:hardening && npm run test:crm-agent-v2:dialogs && npm run test:crm-agent-v2:ui && npm run test:crm-agent-v2:integration",
    "test:payments": "node --test scripts/platform-payments-tests.mjs",
    "test:aisha-dialogs:live": "node scripts/aisha-live-e2e.mjs",
    "prisma:studio": "powershell -ExecutionPolicy Bypass -File ./studio.ps1",
    "prisma:validate": "powershell -ExecutionPolicy Bypass -File ./scripts/prisma.ps1 validate",
    "test:aisha-dialogs:super": "node scripts/aisha-dialog-regression.mjs --suite=super",
    "test:aisha-dialogs:matrix": "node scripts/aisha-dialog-matrix.mjs",
    "test:aisha-dialogs:max": "npm run test:aisha-dialogs && npm run test:aisha-dialogs:super && npm run test:aisha-dialogs:matrix && npm run test:aisha-dialogs:smoke",
    "aisha:replay": "node scripts/aisha-replay.mjs",
    "test:business-registration-plan": "node scripts/business-registration-plan-tests.mjs",
    "check:business-catalog-compat": "node scripts/check-business-catalog-compatibility.mjs",
    "seed:ru": "node scripts/reseed-russian-salon.js",
    "seed:ru:full": "node scripts/reseed-russian-salon-full.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "prisma": "^6.19.1"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
}
