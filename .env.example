POSTGRES_DB=beauty_platform
POSTGRES_USER=beauty_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432
DATABASE_URL=postgresql://beauty_user:CHANGE_ME@localhost:5432/beauty_platform

# Redis pub/sub для real-time обновления CRM Журнала между несколькими web-инстансами.
# Необязательно локально: без REDIS_URL используется in-memory fallback.
REDIS_URL=redis://localhost:6379

# GigaChat (Сбер) API
# Base64(client_id:client_secret) из кабинета GigaChat
GIGACHAT_AUTH_KEY=
# Пример: GigaChat, GigaChat-Pro
GIGACHAT_MODEL=GigaChat
# Необязательные кастомные эндпоинты
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1/chat/completions
# Только для разработки: пропуск проверки TLS, если локальная цепочка сертификатов сломана.
# Не включать в продакшене.
GIGACHAT_ALLOW_INSECURE_TLS=false

# Публичная запись / ИИ ассистент
AI_THREAD_SECRET=
# Обязательно задать для подписи hold-токенов публичной записи.
PUBLIC_BOOKING_HOLD_SECRET=
SESSION_SECRET=
NEXTAUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_INTERNAL_ORIGIN=http://localhost:3000
PLATFORM_PUBLIC_ORIGIN=http://localhost:3000
PLATFORM_PUBLIC_IP=127.0.0.1
PLATFORM_SYSTEM_DOMAINS=localhost,127.0.0.1
DOMAIN_TLS_ASK_SECRET=

# Социальный вход клиентов
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_AUTH_URL=https://oauth.vk.com/authorize
VK_TOKEN_URL=https://oauth.vk.com/access_token
VK_USERINFO_URL=https://api.vk.com/method/users.get
VK_SCOPE=email
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# MAX ID: заполнить после получения OAuth/OIDC параметров у провайдера
MAX_BOT_TOKEN=
NEXT_PUBLIC_MAX_BOT_USERNAME=
MAX_CLIENT_ID=
MAX_CLIENT_SECRET=
MAX_AUTH_URL=
MAX_TOKEN_URL=
MAX_USERINFO_URL=
MAX_SCOPE=profile email

# Необязательно: скрипты для тестирования диалогов ИИ
AISHA_BASE_URL=http://localhost:3000
AISHA_ACCOUNT=
AISHA_TIMEOUT_MS=15000
AISHA_SUITE=all

# SMTP для отправки OTP-кода регистрации CRM
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=ONLAIS
