// Prisma schema for Онлайс (single source of truth)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum AccountOnboardingStatus {
  DRAFT
  INVITED
  ACTIVE
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum UserType {
  STAFF
  CLIENT
}

enum LegalType {
  PRIVATE_SPECIALIST
  SELF_EMPLOYED
  IP
  OOO
}

enum BusinessType {
  BEAUTY_SALON
  HAIR_SALON
  BARBERSHOP
  NAIL_STUDIO
  BROW_STUDIO
  LASH_STUDIO
  MAKEUP_STUDIO
  COSMETOLOGY_ESTHETIC
  COSMETOLOGY_MEDICAL
  MASSAGE
  SPA_CENTER
  TATTOO_STUDIO
  PIERCING_STUDIO
  PMU_STUDIO
  EPILATION_STUDIO
  BATH_WELLNESS
  DENTISTRY
  MEDICAL_CLINIC
  PRIVATE_MEDICAL_PRACTICE
  LAB_DIAGNOSTICS
  ULTRASOUND_DIAGNOSTICS
  PSYCHOLOGIST
  PSYCHOTHERAPIST
  SPEECH_THERAPIST
  NUTRITIONIST
  REHAB_LFK
  FITNESS_CLUB
  GYM
  YOGA_STUDIO
  PILATES_STUDIO
  STRETCHING_STUDIO
  DANCE_STUDIO
  MARTIAL_ARTS_STUDIO
  SWIMMING_POOL
  PERSONAL_TRAINER
  EDUCATION_CENTER
  LANGUAGE_SCHOOL
  TUTORING
  CHILD_CENTER
  EXAM_PREP_CENTER
  CREATIVE_EDU_STUDIO
  LEGAL_CONSULTING
  ACCOUNTING_CONSULTING
  FINANCE_CONSULTING
  BUSINESS_CONSULTING
  COACHING_MENTORING
  VET_CLINIC
  PET_GROOMING
  DOG_TRAINING
  PHOTO_STUDIO_RENT
  REHEARSAL_STUDIO_RENT
  COWORKING_SLOTS
  SPORTS_COURT_BOOKING
  PODCAST_STUDIO
  COMPUTER_CLUB
}

enum RoleName {
  OWNER
  MANAGER
  SPECIALIST
  READONLY
}

enum AppointmentStatus {
  NEW
  CONFIRMED
  IN_PROGRESS
  DONE
  CANCELLED
  NO_SHOW
}

enum ServiceBookingType {
  SINGLE
  GROUP
}

enum GroupSessionStatus {
  NEW
  CONFIRMED
  DONE
  CANCELLED
}

enum PaymentIntentStatus {
  CREATED
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum TransactionType {
  CHARGE
  REFUND
  CAPTURE
  VOID
  OFFLINE_PAYMENT
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  TELEGRAM
  MAX
  PUSH
  SMS
  WEBHOOK
  SSE
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  DEAD
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
  DEAD
}

enum WebhookStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum PublicPageStatus {
  DRAFT
  PUBLISHED
}

enum TemplateType {
  NOTIFICATION
  SEO_PRESET
  CONSTRUCTOR_PRESET
}

enum ScheduleEntryType {
  WORKING
  SICK
  VACATION
  UNPAID_OFF
  NO_SHOW
  PAID_OFF
  CUSTOM
}

enum NotificationScope {
  PLATFORM
  ACCOUNT
  USER
}

enum AudienceType {
  CLIENT
  STAFF
  PLATFORM_ADMIN
}

enum PromotionType {
  PERCENT
  FIXED
  BUNDLE
}

enum PromoRedemptionStatus {
  APPLIED
  CANCELLED
}

enum LoyaltyTransactionType {
  EARN
  SPEND
  EXPIRE
  ADJUSTMENT
  REFUND_REVERSAL
}

enum GiftCardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}

enum MembershipType {
  COUNT
  PERIOD
}

enum IdentityProvider {
  EMAIL
  PHONE
  TELEGRAM
  MAX
  VK
  YANDEX
}

enum SessionType {
  PLATFORM
  CRM
  CLIENT
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ReviewStatus {
  PUBLISHED
  PENDING
  HIDDEN
}

enum OutboxScope {
  PLATFORM
  ACCOUNT
  USER
}

model PlatformPlan {
  id            Int                    @id @default(autoincrement())
  name          String
  code          String                 @unique
  description   String?
  priceMonthly  Decimal                @db.Decimal(12, 2)
  currency      String                 @default("RUB")
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  features      PlatformPlanFeature[]
  subscriptions PlatformSubscription[]
  accounts      Account[]
}

model PlatformPlanFeature {
  id        Int      @id @default(autoincrement())
  planId    Int
  key       String
  value     String?
  createdAt DateTime @default(now())

  plan PlatformPlan @relation(fields: [planId], references: [id])

  @@unique([planId, key])
}

model PlatformSubscription {
  id            Int                @id @default(autoincrement())
  accountId     Int
  planId        Int
  status        SubscriptionStatus @default(ACTIVE)
  startedAt     DateTime           @default(now())
  endsAt        DateTime?
  nextBillingAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  account  Account           @relation(fields: [accountId], references: [id])
  plan     PlatformPlan      @relation(fields: [planId], references: [id])
  invoices PlatformInvoice[]

  @@index([accountId, status])
}

model PlatformInvoice {
  id             Int           @id @default(autoincrement())
  accountId      Int
  subscriptionId Int?
  status         InvoiceStatus @default(DRAFT)
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("RUB")
  issuedAt       DateTime?
  dueAt          DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  account      Account               @relation(fields: [accountId], references: [id])
  subscription PlatformSubscription? @relation(fields: [subscriptionId], references: [id])
  payments     PlatformPayment[]

  @@index([accountId, status])
}

model PlatformPayment {
  id          Int           @id @default(autoincrement())
  invoiceId   Int?
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("RUB")
  status      PaymentStatus @default(PENDING)
  provider    String?
  providerRef String?
  createdAt   DateTime      @default(now())

  invoice PlatformInvoice? @relation(fields: [invoiceId], references: [id])
}

model PlatformLimit {
  id        Int      @id @default(autoincrement())
  accountId Int
  key       String
  valueInt  Int?
  valueJson Json?
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@unique([accountId, key])
}

model PlatformAdmin {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())

  user        User                                @relation(fields: [userId], references: [id])
  permissions PlatformAdminPermissionAssignment[]
  audits      PlatformAuditLog[]
}

model PlatformPermission {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  assignments PlatformAdminPermissionAssignment[]
}

model PlatformAdminPermissionAssignment {
  id           Int      @id @default(autoincrement())
  adminId      Int
  permissionId Int
  createdAt    DateTime @default(now())

  admin      PlatformAdmin      @relation(fields: [adminId], references: [id])
  permission PlatformPermission @relation(fields: [permissionId], references: [id])

  @@unique([adminId, permissionId])
}

model PlatformAuditLog {
  id         Int      @id @default(autoincrement())
  adminId    Int
  action     String
  targetType String
  targetId   String?
  ipAddress  String?
  diffJson   Json?
  createdAt  DateTime @default(now())

  admin PlatformAdmin @relation(fields: [adminId], references: [id])

  @@index([adminId, createdAt])
}

model AccountAuditLog {
  id         Int      @id @default(autoincrement())
  accountId  Int
  userId     Int
  action     String
  targetType String
  targetId   String?
  ipAddress  String?
  diffJson   Json?
  createdAt  DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([accountId, createdAt])
  @@index([userId, createdAt])
}

model PlatformSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  valueJson Json
  updatedAt DateTime @updatedAt
}

model PlatformLegalDocument {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  title       String
  description String?
  isRequired  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions PlatformLegalDocumentVersion[]

  @@index([sortOrder])
}

model PlatformLegalDocumentVersion {
  id          Int      @id @default(autoincrement())
  documentId  Int
  version     Int
  content     String
  publishedAt DateTime @default(now())
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  document PlatformLegalDocument @relation(fields: [documentId], references: [id])

  @@unique([documentId, version])
  @@index([documentId, isActive])
}

model TemplateLibrary {
  id          Int          @id @default(autoincrement())
  type        TemplateType
  name        String
  description String?
  contentJson Json
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  versions TemplateVersion[]
}

model TemplateVersion {
  id          Int      @id @default(autoincrement())
  templateId  Int
  version     Int
  contentJson Json
  createdAt   DateTime @default(now())

  template TemplateLibrary @relation(fields: [templateId], references: [id])

  @@unique([templateId, version])
}

model HealthCheck {
  id        Int      @id @default(autoincrement())
  name      String
  status    String
  checkedAt DateTime @default(now())
  details   Json?
}

model MonitoringMetric {
  id        Int      @id @default(autoincrement())
  name      String
  value     Float
  createdAt DateTime @default(now())
}

model SystemAlert {
  id         Int       @id @default(autoincrement())
  level      String
  message    String
  details    Json?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

model Account {
  id                    Int                     @id @default(autoincrement())
  name                  String
  slug                  String                  @unique
  status                AccountStatus           @default(ACTIVE)
  onboardingStatus      AccountOnboardingStatus @default(ACTIVE)
  legalType             LegalType?
  businessType          BusinessType?
  timeZone              String
  onboardingCompletedAt DateTime?
  planId                Int?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  plan                    PlatformPlan?            @relation(fields: [planId], references: [id])
  platformSubscriptions   PlatformSubscription[]
  platformInvoices        PlatformInvoice[]
  platformLimits          PlatformLimit[]
  settings                AccountSetting?
  branding                AccountBranding?
  profile                 AccountProfile?
  domains                 AccountDomain[]
  publicPages             PublicPage[]
  seoSettings             SeoSetting?
  seoPageSettings         SeoPageSetting[]
  mediaCollections        MediaCollection[]
  locations               Location[]
  locationManagers        LocationManager[]
  services                Service[]
  serviceCategories       ServiceCategory[]
  specialistCategories    SpecialistCategory[]
  roles                   Role[]
  users                   RoleAssignment[]
  clients                 Client[]
  clientTags              ClientTag[]
  specialistProfiles      SpecialistProfile[]
  appointments            Appointment[]
  appointmentHolds        AppointmentHold[]
  groupSessions           GroupSession[]
  scheduleTemplates       ScheduleTemplate[]
  scheduleEntries         ScheduleEntry[]
  scheduleNonWorkingTypes ScheduleNonWorkingType[]
  blockedSlots            BlockedSlot[]
  userSessions            UserSession[]
  paymentIntents          PaymentIntent[]
  transactions            Transaction[]
  refunds                 Refund[]
  receipts                Receipt[]
  paymentMethods          PaymentMethod[]
  promotions              Promotion[]
  promoCodes              PromoCode[]
  referrals               Referral[]
  giftCards               GiftCard[]
  memberships             Membership[]
  loyaltyRules            LoyaltyRule[]
  loyaltyWallets          LoyaltyWallet[]
  reviews                 Review[]
  ratingAggregates        RatingAggregate[]
  notifications           Notification[]
  notificationTemplates   NotificationTemplate[]
  notificationPreferences NotificationPreference[]
  outboxItems             OutboxItem[]
  idempotencyKeys         IdempotencyKey[]
  legalDocuments          LegalDocument[]
  legalAcceptances        LegalAcceptance[]
  onlineBookingSessions   OnlineBookingSession[]
  onlineBookingSteps      OnlineBookingStep[]
  aiThreads               AiThread[]
  aiThreadGroups          AiThreadGroup[]
  webhookEndpoints        WebhookEndpoint[]
  audits                  AccountAuditLog[]
  invites                 AccountInvite[]

  @@index([status, createdAt])
}

model AccountInvite {
  id               Int       @id @default(autoincrement())
  accountId        Int
  email            String
  tokenHash        String    @unique
  invitedByAdminId Int?
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId, email])
  @@index([expiresAt])
}

model AccountSetting {
  id                        Int      @id @default(autoincrement())
  accountId                 Int      @unique
  slotStepMinutes           Int      @default(15)
  requireDeposit            Boolean  @default(false)
  requirePaymentToConfirm   Boolean  @default(false)
  cancellationWindowHours   Int?
  rescheduleWindowHours     Int?
  holdTtlMinutes            Int?
  defaultReminderHours      Int?
  notificationQuietHours    Json?
  reviewAutoPublish         Boolean  @default(true)
  reviewAllowReplies        Boolean  @default(true)
  reviewModerationWords     Json?
  reviewModerationMode      String   @default("auto")
  reviewModerationMinRating Int?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id])
}

model AccountBranding {
  id             Int      @id @default(autoincrement())
  accountId      Int      @unique
  logoUrl        String?
  coverUrl       String?
  accentColor    String?
  secondaryColor String?
  themePreset    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id])
}

model AccountProfile {
  id           Int      @id @default(autoincrement())
  accountId    Int      @unique
  description  String?
  phone        String?
  email        String?
  address      String?
  websiteUrl   String?
  instagramUrl String?
  whatsappUrl  String?
  telegramUrl  String?
  maxUrl       String?
  vkUrl        String?
  viberUrl     String?
  pinterestUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id])
}

model AccountDomain {
  id            Int       @id @default(autoincrement())
  accountId     Int
  domain        String    @unique
  isPrimary     Boolean   @default(false)
  status        String    @default("PENDING")
  sslStatus     String    @default("PENDING")
  verifiedAt    DateTime?
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id])
}

model PublicPage {
  id                 Int              @id @default(autoincrement())
  accountId          Int
  status             PublicPageStatus @default(DRAFT)
  draftJson          Json?
  publishedVersionId Int?             @unique
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  account          Account             @relation(fields: [accountId], references: [id])
  versions         PublicPageVersion[]
  publishedVersion PublicPageVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id])
  sections         PublicPageSection[]
  media            PublicPageMedia[]

  @@index([accountId, status])
}

model PublicPageVersion {
  id           Int      @id @default(autoincrement())
  publicPageId Int
  version      Int
  contentJson  Json
  createdAt    DateTime @default(now())

  publicPage   PublicPage  @relation(fields: [publicPageId], references: [id])
  publishedFor PublicPage? @relation("PublishedVersion")

  @@unique([publicPageId, version])
}

model PublicPageSection {
  id           Int      @id @default(autoincrement())
  publicPageId Int
  key          String
  title        String?
  sortOrder    Int
  isVisible    Boolean  @default(true)
  layoutPreset String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  publicPage PublicPage        @relation(fields: [publicPageId], references: [id])
  blocks     PublicPageBlock[]

  @@index([publicPageId, sortOrder])
}

model PublicPageBlock {
  id          Int      @id @default(autoincrement())
  sectionId   Int
  type        String
  contentJson Json
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  section PublicPageSection @relation(fields: [sectionId], references: [id])

  @@index([sectionId, sortOrder])
}

model PublicPageMedia {
  id           Int      @id @default(autoincrement())
  publicPageId Int
  assetId      Int
  sortOrder    Int
  createdAt    DateTime @default(now())

  publicPage PublicPage @relation(fields: [publicPageId], references: [id])
  asset      MediaAsset @relation(fields: [assetId], references: [id])

  @@index([publicPageId, sortOrder])
}

model SeoSetting {
  id             Int      @id @default(autoincrement())
  accountId      Int      @unique
  title          String?
  description    String?
  ogImageUrl     String?
  schemaJson     Json?
  robots         String?
  sitemapEnabled Boolean  @default(true)
  verificationMetaTags String?
  verificationHtmlFilename String?
  verificationHtmlContent String?
  verificationHtmlFiles Json?
  updatedAt      DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id])
}

model SeoPageSetting {
  id          Int      @id @default(autoincrement())
  accountId   Int
  pageKey     String
  title       String?
  description String?
  ogImageUrl  String?
  keywords    String?
  canonicalUrl String?
  noIndex     Boolean  @default(false)
  noFollow    Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id])

  @@unique([accountId, pageKey])
  @@index([accountId])
}

model LegalDocument {
  id          Int      @id @default(autoincrement())
  accountId   Int
  key         String
  title       String
  description String?
  isRequired  Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account  Account                @relation(fields: [accountId], references: [id])
  versions LegalDocumentVersion[]

  @@unique([accountId, key])
  @@index([accountId, sortOrder])
}

model LegalDocumentVersion {
  id          Int      @id @default(autoincrement())
  documentId  Int
  version     Int
  content     String
  publishedAt DateTime @default(now())
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  document    LegalDocument     @relation(fields: [documentId], references: [id])
  acceptances LegalAcceptance[]

  @@unique([documentId, version])
  @@index([documentId, isActive])
}

model LegalAcceptance {
  id                Int      @id @default(autoincrement())
  accountId         Int
  documentVersionId Int
  appointmentId     Int?
  clientId          Int?
  source            String
  ip                String?
  userAgent         String?
  acceptedAt        DateTime @default(now())

  account         Account              @relation(fields: [accountId], references: [id])
  documentVersion LegalDocumentVersion @relation(fields: [documentVersionId], references: [id])
  appointment     Appointment?         @relation(fields: [appointmentId], references: [id])
  client          Client?              @relation(fields: [clientId], references: [id])

  @@index([accountId, acceptedAt])
  @@index([appointmentId])
}

model Category {
  id        Int      @id @default(autoincrement())
  accountId Int?
  name      String
  slug      String
  createdAt DateTime @default(now())

  @@index([accountId])
}

model Tag {
  id        Int      @id @default(autoincrement())
  accountId Int?
  name      String
  slug      String
  createdAt DateTime @default(now())

  @@index([accountId])
}

model MediaAsset {
  id         Int       @id @default(autoincrement())
  accountId  Int?
  url        String
  type       String
  width      Int?
  height     Int?
  size       Int?
  altText    String?
  metadata   Json?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  links           MediaLink[]
  publicPageMedia PublicPageMedia[]

  @@index([accountId, archivedAt])
}

model MediaCollection {
  id        Int      @id @default(autoincrement())
  accountId Int
  name      String
  createdAt DateTime @default(now())

  account Account     @relation(fields: [accountId], references: [id])
  links   MediaLink[]
}

model MediaLink {
  id           Int      @id @default(autoincrement())
  assetId      Int
  collectionId Int?
  entityType   String
  entityId     String
  sortOrder    Int      @default(0)
  isCover      Boolean  @default(false)
  createdAt    DateTime @default(now())

  asset      MediaAsset       @relation(fields: [assetId], references: [id])
  collection MediaCollection? @relation(fields: [collectionId], references: [id])

  @@index([entityType, entityId])
  @@index([entityType, entityId, sortOrder])
}

model Review {
  id                     Int          @id @default(autoincrement())
  accountId              Int
  clientId               Int
  appointmentId          Int?
  entityType             String       @default("account")
  entityId               String?
  rating                 Int
  comment                String?
  status                 ReviewStatus @default(PUBLISHED)
  replyText              String?
  repliedAt              DateTime?
  repliedByUserId        Int?
  moderationReason       String?
  moderationMatchedWords Json?
  moderatedAt            DateTime?
  moderatedByUserId      Int?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  account       Account      @relation(fields: [accountId], references: [id])
  client        Client       @relation(fields: [clientId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  repliedByUser User?        @relation("ReviewReplyUser", fields: [repliedByUserId], references: [id])
  votes         ReviewVote[]

  @@unique([appointmentId])
  @@index([accountId, status, createdAt])
  @@index([accountId, entityType, entityId, status])
}

model ReviewVote {
  id        Int      @id @default(autoincrement())
  reviewId  Int
  userId    Int?
  value     Int
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])
}

model RatingAggregate {
  id          Int      @id @default(autoincrement())
  accountId   Int
  entityType  String
  entityId    String
  ratingAvg   Float
  ratingCount Int
  updatedAt   DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id])

  @@unique([entityType, entityId])
}

model Favorite {
  id         Int      @id @default(autoincrement())
  clientId   Int
  entityType String
  entityId   String
  createdAt  DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, entityType, entityId])
}

model SearchIndex {
  id         Int      @id @default(autoincrement())
  accountId  Int?
  entityType String
  entityId   String
  payload    Json
  updatedAt  DateTime @updatedAt

  @@index([accountId])
}

model GeoPoint {
  id         Int   @id @default(autoincrement())
  locationId Int   @unique
  lat        Float
  lng        Float

  location Location @relation(fields: [locationId], references: [id])
}

model Location {
  id           Int      @id @default(autoincrement())
  accountId    Int
  name         String
  address      String
  description  String?
  phone        String?
  status       String   @default("ACTIVE")
  websiteUrl   String?
  instagramUrl String?
  whatsappUrl  String?
  telegramUrl  String?
  maxUrl       String?
  vkUrl        String?
  viberUrl     String?
  pinterestUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account         Account              @relation(fields: [accountId], references: [id])
  geoPoint        GeoPoint?
  hours           LocationHour[]
  scheduleEntries ScheduleEntry[]
  exceptions      LocationException[]
